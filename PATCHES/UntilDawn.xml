    <Metadata Title="Until Dawn" Name="macOS Memory Workaround" Notes="Works around memory mapping issue on macOS." Author="mavethee" PatchVer="1.0" AppVer="01.03" AppElf="eboot.bin" isEnabled="false">
        <PatchList>
            <!-- 0x1000000000 Primary Engine Pools -> 0x8000000000 -->
            <Line Type="byte" Address="0x85cc42" Value="0x80"/>
            <Line Type="byte" Address="0x85ce8f" Value="0x80"/>
            <Line Type="byte" Address="0x85e0a3" Value="0x80"/>
            <Line Type="byte" Address="0x85e827" Value="0x80"/>

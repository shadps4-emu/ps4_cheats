    <Metadata Title="inFAMOUS Second Son"
              Name="Disable depth of field"
              Note="Forces the engine's own depth-of-field-off path. The chain that drives the circle-of-confusion, downsample, bokeh and DOF composite passes already sits behind a guard the game skips when its DOF amount is zero; this makes that guard's jump unconditional."
              Author="junminlee2004"
              PatchVer="1.2"
              AppVer="01.07"
              AppElf="eboot.bin"
              isEnabled="false">
